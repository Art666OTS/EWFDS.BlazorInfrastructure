@using EWFDS.BlazorInfrastructure.Components.Shared.dd

@if (isLoading)
{
    <span class="text-muted"><em>Loading...</em></span>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <span class="text-danger">@errorMessage</span>
}
else if (BTID > 0)
{
    <span class="form-control-plaintext">@binTypeDesc</span>
}
else
{
    <TelerikDropDownList Data="@binTypeOptions"
                         Value="@selectedValue"
                         ValueChanged="@((string val) => OnValueChanged(val))"
                         TextField="Text"
                         ValueField="Value"
                         DefaultText="Select Type"
                         Width="100%">
    </TelerikDropDownList>
}
